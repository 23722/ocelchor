# Discovery outputs: only the canonical artifact files are tracked (model,
# process tree, diagnostics, chor-js render report per log) — the regression
# baseline, auditable via git diff. Everything else under data/output
# (rendered SVGs — large, regenerable — and ad-hoc figure/layout
# experiments) stays ignored.
data/output/**
!data/output/*/
!data/output/.gitkeep
!data/output/*/discovered_model.bpmn
!data/output/*/process_tree.txt
!data/output/*/diagnostics.json
!data/output/*/discovered_model.chorjs.report.json

# One-off validation script (M4): instruments pm4py's fallthrough factory to
# cross-check the signature-based D9/D10 flags against ground truth. Not part
# of the published artifact.
tools/instrument_fallthroughs.py

# chor-js render harness (local dev tooling only, not part of the published
# artifact): drives the third-party chor-js renderer headlessly to verify
# model layout. Contains a bundled copy of chor-js (built from the separately
# downloaded chor-js-demo), node_modules, and the driver scripts. Rebuildable;
# excluded from the repo entirely.
tools/chorjs-render/
